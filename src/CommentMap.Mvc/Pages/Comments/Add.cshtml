@page
@model AddModel
@{
    ViewData["Title"] = "Add new comment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ol.min.css" asp-append-version="true" />
}

<h1 class="text-2xl font-bold mb-4">Add new comment</h1>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4" id="root">
    <div class="lg:col-span-5">
        <form method="post" data-locale="@Model.CurrentLocale" class="space-y-4">
            <div class="fieldset">
                <label class="fieldset-label" asp-for="Input.Title">Title</label>
                <input asp-for="Input.Title" class="input input-bordered w-full" aria-describedby="title-help" placeholder="Title" />
                <div id="title-help" class="text-sm text-base-content/70">Your title must be 1-100 characters long.</div>
                <span asp-validation-for="Input.Title" class="field-validation-error text-sm" role="alert"></span>
            </div>

            <div class="fieldset">
                <label class="fieldset-label" asp-for="Input.Text">Text</label>
                <textarea asp-for="Input.Text" class="textarea textarea-bordered w-full" aria-describedby="text-help" placeholder="Text"></textarea>
                <div id="text-help" class="text-sm text-base-content/70">Your text must be 1-250 characters long.</div>
                <span asp-validation-for="Input.Text" class="field-validation-error text-sm" role="alert"></span>
            </div>

            <div>
                <input type="hidden" asp-for="Input.Longitude" data-longitude="true" />
                <span asp-validation-for="Input.Longitude" class="field-validation-error text-sm" role="alert"></span>
            </div>

            <div>
                <input type="hidden" asp-for="Input.Latitude" data-latitude="true" />
                <span asp-validation-for="Input.Latitude" class="field-validation-error text-sm" role="alert"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
    <div class="lg:col-span-7">
        <div id="map" class="sticky top-0 w-full h-screen rounded-box overflow-hidden"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/addComment.min.js" asp-append-version="true"></script>
}
