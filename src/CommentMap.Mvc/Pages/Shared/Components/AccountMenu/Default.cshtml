@using CommentMap.Mvc.ViewModels
@* Account dropdown: Account/Logout when signed in, Register/Login for guests. *@
@model AccountMenuViewModel

<details class="dropdown dropdown-end">
    <summary role="button" class="btn btn-ghost btn-circle" aria-label="Account">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current stroke-[1.5]">
            <path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
    </summary>
    <ul class="menu menu-sm dropdown-content bg-base-100 rounded-box w-40 shadow-sm">
    @if (Model.IsSignedIn)
    {
        <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Account</a></li>
        <li>
            <form id="logout-form"
                  class="hidden"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            </form>
            <button type="submit" form="logout-form">Logout</button>
        </li>
    }
    else
    {
        <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
        <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
    }
    </ul>
</details>