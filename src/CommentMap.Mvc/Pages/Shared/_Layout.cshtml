<!DOCTYPE html>
<html lang="en" data-theme="corporate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CommentMap.Mvc</title>
    <link type="image/png" sizes="16x16" rel="icon" href="~/assets/favicon-16x16.png">
    <link type="image/png" sizes="32x32" rel="icon" href="~/assets/favicon-32x32.png">
    <link type="image/png" sizes="96x96" rel="icon" href="~/assets/favicon-96x96.png">
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar bg-base-100 shadow-sm sticky top-0 z-50">
        <div class="navbar-start">
            <details class="dropdown lg:hidden">
                <summary role="button" class="btn btn-ghost btn-circle" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current stroke-[1.5]">
                        <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </summary>
                <ul class="menu menu-sm dropdown-content bg-base-100 rounded-box w-40 shadow-sm">
                    <li><a asp-area="" asp-page="/Index">Home</a></li>
                    <li><a asp-area="" asp-page="/Comments/Index">My comments</a></li>
                </ul>
            </details>
            <a class="btn btn-ghost text-xl" asp-area="" asp-page="/Index">CommentMap</a>
        </div>

        <ul class="navbar-center hidden lg:flex menu menu-horizontal gap-2">
            <li><a asp-area="" asp-page="/Index">Home</a></li>
            <li><a asp-area="" asp-page="/Comments/Index">My comments</a></li>
        </ul>

        <div class="navbar-end gap-2">
            <label class="swap swap-rotate" aria-label="Toggle theme">
                <input type="checkbox" data-theme-toggle />
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="swap-on size-5 fill-none stroke-current stroke-[1.5]">
                    <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="swap-off size-5 fill-none stroke-current stroke-[1.5]">
                    <path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                </svg>
            </label>
            <vc:account-menu />
        </div>
    </nav>

    <main class="container mx-auto p-2">
        @RenderBody()
    </main>

    <script src="~/js/site.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
