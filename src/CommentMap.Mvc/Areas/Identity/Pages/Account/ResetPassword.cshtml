@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
<h2 class="text-lg font-semibold">Reset your password.</h2>
<hr class="my-4" />
<div class="max-w-md">
    <form method="post" class="card bg-base-100 border border-base-300 p-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-error" role="alert"></div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="input input-bordered w-full" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
            <span asp-validation-for="Input.Password" class="field-validation-error text-sm"></span>
        </div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="input input-bordered w-full" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error text-sm"></span>
        </div>
        <button type="submit" class="w-full btn btn-lg btn-primary">Reset</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
