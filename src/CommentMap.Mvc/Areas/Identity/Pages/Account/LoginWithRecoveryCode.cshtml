@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code verification";
}

<h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
<hr class="my-4" />
<p>
    You have requested to log in with a recovery code. This login will not be remembered until you provide
    an authenticator app code at log in or disable 2FA and log in again.
</p>
<div class="max-w-md">
    <form method="post" class="card bg-base-100 border border-base-300 p-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-error" role="alert"></div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.RecoveryCode">Recovery code</label>
            <input asp-for="Input.RecoveryCode" class="input input-bordered w-full" autocomplete="off" placeholder="RecoveryCode" />
            <span asp-validation-for="Input.RecoveryCode" class="field-validation-error text-sm"></span>
        </div>
        <button type="submit" class="w-full btn btn-lg btn-primary">Log in</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
