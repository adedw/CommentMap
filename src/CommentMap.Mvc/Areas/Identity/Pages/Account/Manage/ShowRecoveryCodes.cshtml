@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData[ManageNavPages.ActivePageKey] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="text-xl font-bold">@ViewData["Title"]</h2>

<p>Recovery code are used to access your account when you cannot recive your authentication codes.</p>

<div class="alert alert-warning shadow-lg mt-4" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current stroke-[1.5]">
        <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <div>
        <h3 class="font-bold">Put these codes in a safe place.</h3>
        <p>If you lose your device and don't have the recovery codes you will lose access to your account.</p>
    </div>
</div>

<div class="rounded-sm bg-base-100 shadow-lg grid grid-cols-2 mt-4 p-4">
    @foreach (var code in Model.RecoveryCodes)
    {
        <code data-recovery-code class="font-semibold">@code</code>
    }
</div>

<div class="mt-4">
    <a class="btn btn-success" asp-page="./TwoFactorAuthentication">Done</a>
    <a id="download-recovery-codes" class="btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current stroke-[1.5]">
            <path d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Download
    </a>
</div>

@section Scripts {
    <script src="~/js/ShowRecoveryCodes.min.js" asp-append-version="true"></script>
}