@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
}

<h3 class="text-xl font-bold">Set your password</h3>

<p class="text-info mt-2">
    You do not have a local password for this site. Add a local account 
    so you can log in without an external login.
</p>
<div class="max-w-md mt-4">
    <form method="post" class="card bg-base-100 border border-base-300 p-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-error" role="alert"></div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.NewPassword">New password</label>
            <input asp-for="Input.NewPassword" class="input input-bordered w-full" autocomplete="new-password" placeholder="Please enter your new password." />
            <span asp-validation-for="Input.NewPassword" class="field-validation-error text-sm"></span>
        </div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="input input-bordered w-full" autocomplete="new-password" placeholder="Please confirm your new password." />
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error text-sm"></span>
        </div>
        <button type="submit" class="w-full btn btn-lg btn-primary">Set password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
