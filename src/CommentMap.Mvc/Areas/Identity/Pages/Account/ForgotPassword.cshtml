@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
<h2 class="text-lg font-semibold">Enter your email.</h2>
<hr class="my-4" />
<div class="max-w-md">
    <form method="post" class="card bg-base-100 border border-base-300 p-6 space-y-4">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="fieldset">
            <label class="fieldset-label" asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="input input-bordered w-full" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="field-validation-error text-sm"></span>
        </div>
        <button type="submit" class="w-full btn btn-lg btn-primary">Reset Password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
