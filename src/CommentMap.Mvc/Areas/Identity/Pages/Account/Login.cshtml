@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<h1 class="text-2xl font-bold">@ViewData["Title"]</h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="max-w-md">
        <section>
            <form method="post" class="card bg-base-100 border border-base-300 p-6 space-y-4">
                <h2 class="text-lg font-semibold">Use a local account to log in.</h2>
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="fieldset">
                    <label class="fieldset-label" asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="input input-bordered w-full" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="field-validation-error text-sm"></span>
                </div>
                <div class="fieldset">
                    <label class="fieldset-label" asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" class="input input-bordered w-full" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="field-validation-error text-sm"></span>
                </div>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="Input.RememberMe" class="checkbox checkbox-primary" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
                <button type="submit" class="btn btn-primary w-full">Log in</button>
                <div>
                    <p>
                        <a asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </p>
                    <p>
                        <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="max-w-md">
        <section>
            <h3 class="text-lg font-semibold mb-4">Use another service to log in.</h3>
            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn btn-outline w-full mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                }
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
