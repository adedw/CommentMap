@page
@model CommentMap.Mvc.Areas.Identity.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<header>
    <h1 class="text-2xl font-bold text-warning">@ViewData["Title"]</h1>
    <p class="text-warning">This account has been temporarily locked due to too many failed login attempts. Try again later.</p>
</header>
